{
  "name": "patterm",
  "version": "0.6.0",
  "description": "Professional Serial Terminal Application",
  "main": "src/main/main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "electron src/main/main.js",
    "dev:renderer": "wait-on http://localhost:3000 && electron .",
    "build": "echo 'No build step required for vanilla JavaScript'",
    "lint": "echo 'Lint check passed (no linter configured)'",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:electron": "playwright test --config=playwright.electron.config.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "bash scripts/test.sh",
    "test:ci": "npm run lint && npm test && npm run web:test:ci && npm run test:electron",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "web:dev": "cd web && vite",
    "web:build": "cd web && vite build",
    "web:preview": "cd web && vite preview",
    "web:serve": "cd web && vite preview --https",
    "web:test": "cd web && playwright test",
    "web:test:ci": "(cd web; setsid sh -c 'npx vite --port 5173 > /tmp/patterm-vite.log 2>&1' & VITE_PID=$!; npx wait-on tcp:127.0.0.1:5173; playwright test tests/simple.spec.js tests/connection-ui.spec.js --config=playwright.config.no-server.js; STATUS=$?; pkill -TERM -g $VITE_PID || true; exit $STATUS)"
  },
  "keywords": [
    "serial",
    "terminal",
    "uart",
    "rs232",
    "com-port"
  ],
  "author": {
    "name": "Patterm Team",
    "email": "oroliy@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.2.0",
    "playwright": "^1.57.0",
    "playwright-core": "^1.58.2",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@serialport/parser-delimiter": "^13.0.0",
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "build": {
    "appId": "com.patterm.app",
    "productName": "Patterm",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "Patterm-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": "x64"
        },
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "artifactName": "Patterm-${version}-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "Patterm-${version}-x64-portable.${ext}"
    },
    "linux": {
      "artifactName": "Patterm-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        },
        {
          "target": "AppImage",
          "arch": "arm64"
        },
        {
          "target": "deb",
          "arch": "x64"
        },
        {
          "target": "deb",
          "arch": "arm64"
        }
      ]
    }
  },
  "overrides": {
    "tar": "7.5.10",
    "lodash": "^4.17.23",
    "cacache": {
      "glob": "10.5.0"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/main/main.js",
      "!src/renderer/**/*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  }
}
